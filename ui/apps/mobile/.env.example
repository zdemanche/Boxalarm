COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_WITH_USER_POOL_ID
COGNITO_NATIVE_CLIENT_ID=REPLACE_WITH_NATIVE_APP_CLIENT_ID
COGNITO_HOSTED_UI_ORIGIN=https://REPLACE_WITH_DOMAIN.auth.us-east-1.amazoncognito.com
CRITICAL_ALERTS_ENTITLEMENT_GRANTED=false
# APNs environment this build is signed for, sent with the iOS push token so the backend uses the
# matching APNs host (a token sent to the other host is rejected as BadDeviceToken and disabled).
# Leave unset to follow the build: Debug (__DEV__) -> development, Release -> production. Set it
# for a Release build installed from Xcode with development signing: APNS_ENVIRONMENT=development
# APNS_ENVIRONMENT=
